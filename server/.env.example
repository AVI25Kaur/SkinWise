# SkinWise Backend PostgreSQL Environment Variables
PORT=5000

# Connection Option 1: Cloud Connection String (e.g. Render, Supabase, Neon)
# DATABASE_URL=postgresql://username:password@host:5432/skinwise?sslmode=require

# Connection Option 2: Individual Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skinwise
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
